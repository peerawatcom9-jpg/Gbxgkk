local function addSwitch(emoji, name, callback, order)
    local c = Instance.new("Frame")
    c.Parent = ScrollFrame
    c.BackgroundColor3 = Color3.fromRGB(145, 0, 0)
    c.Size = UDim2.new(1, 0, 0, 32)
    c.LayoutOrder = order
    c.CornerRadius = UDim.new(0, 8)

    local t = Instance.new("TextLabel")
    t.Parent = c
    t.BackgroundTransparency = 1
    t.Position = UDim2.new(0, 10, 0, 0)
    t.Size = UDim2.new(0.75, 0, 1, 0)
    t.Font = Enum.Font.Gotham
    t.Text = emoji.." "..name
    t.TextColor3 = Color3.fromRGB(255, 255, 255)
    t.TextSize = 12
    t.TextXAlignment = Enum.TextXAlignment.Left

    -- สวิตช์ไฟ
    local s = Instance.new("TextButton")
    s.Parent = c
    s.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    s.Position = UDim2.new(0.85, 0, 0.5, -11)
    s.Size = UDim2.new(0, 44, 0, 22)
    s.Text = ""
    s.CornerRadius = UDim.new(1, 0)
    s.AutoButtonColor = false

    local k = Instance.new("Frame")
    k.Parent = s
    k.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
    k.Position = UDim2.new(0, 2, 0.5, -9)
    k.Size = UDim2.new(0, 18, 0, 18)
    k.CornerRadius = UDim.new(1, 0)

    local isOn = false
    s.MouseButton1Click:Connect(function()
        isOn = not isOn
        TweenService:Create(s, TweenInfo.new(0.15), {BackgroundColor3 = isOn and Color3.fromRGB(0, 200, 90) or Color3.fromRGB(70, 70, 70)}):Play()
        TweenService:Create(k, TweenInfo.new(0.15), {Position = isOn and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)}):Play()
        callback(isOn)
    end)
end

local function addSlider(emoji, name, min, max, def, cb, order)
    local c = Instance.new("Frame")
    c.Parent = ScrollFrame
    c.BackgroundColor3 = Color3.fromRGB(145, 0, 0)
    c.Size = UDim2.new(1, 0, 0, 44)
    c.LayoutOrder = order
    c.CornerRadius = UDim.new(0, 8)

    local t = Instance.new("TextLabel")
    t.Parent = c
    t.BackgroundTransparency = 1
    t.Position = UDim2.new(0, 10, 0, 2)
    t.Size = UDim2.new(1, -20, 0, 16)
    t.Font = Enum.Font.Gotham
    t.Text = emoji.." "..name..": "..def
    t.TextColor3 = Color3.fromRGB(255, 255, 255)
    t.TextSize = 11

    local b = Instance.new("Frame")
    b.Parent = c
    b.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
    b.Position = UDim2.new(0, 10, 0, 24)
    b.Size = UDim2.new(1, -20, 0, 10)
    b.CornerRadius = UDim.new(1, 0)

    local f = Instance.new("Frame")
    f.Parent = b
    f.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    f.CornerRadius = UDim.new(1, 0)
    f.Size = UDim2.new((def-min)/(max-min), 0, 1, 0)

    local v = def, local drag = false
    local function upd(i)
        local p = math.clamp((i.Position.X - b.AbsolutePosition.X)/b.AbsoluteSize.X, 0, 1)
        v = math.floor(min + p*(max-min)); f.Size = UDim2.new(p,0,1,0)
        t.Text = emoji.." "..name..": "..v; cb(v)
    end
    b.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag=true; upd(i) end end)
    UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end)
end

local function addInput(emoji, name, ph, cb, order)
    local c = Instance.new("Frame")
