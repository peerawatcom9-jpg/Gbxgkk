    t.BackgroundTransparency = 1
    t.Position = UDim2.new(0, 10, 0, 0)
    t.Size = UDim2.new(1, -20, 0, 16)
    t.Font = Enum.Font.Gotham; t.Text = emoji.." "..name
    t.TextColor3 = Color3.fromRGB(255,255,255); t.TextSize = 11; t.TextXAlignment = Enum.TextXAlignment.Left

    local b = Instance.new("TextBox")
    b.Parent = c
    b.BackgroundColor3 = Color3.fromRGB(255,255,255)
    b.Position = UDim2.new(0,10,0,18)
    b.Size = UDim2.new(1,-20,0,20)
    b.Font = Enum.Font.Gotham; b.Text = ""; b.PlaceholderText = ph
    b.TextColor3 = Color3.fromRGB(0,0,0); b.TextSize = 11; b.ClearTextOnFocus = true
    b.FocusLost:Connect(function(e) if e and b.Text~="" then cb(b.Text); b.Text="" end end)
end

