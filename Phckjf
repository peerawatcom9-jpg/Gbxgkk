addSwitch("⬆️", "กระโดดไม่จำกัด", function(on)
    if on then connections.JumpInf = UserInputService.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Space and humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
    end) else if connections.JumpInf then connections.JumpInf:Disconnect() end end
end, 3)
addSwitch("📈", "กระโดดสูง", function(on) if humanoid then humanoid.JumpPower = on and 50 or origJump end end, 4)
addSlider("📈", "ปรับความสูงกระโดด", 10, 200, 50, function(v) if humanoid then humanoid.JumpPower = v end end, 5)
addSwitch("✈️", "บินได้", function(on)
    if on then
        if humanoid then humanoid.PlatformStand = true end
        connections.Fly = RunService.RenderStepped:Connect(function()
            if not rootPart then return end
            local c = Workspace.CurrentCamera.CFrame
            local m = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then m += c.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then m -= c.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then m -= c.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then m += c.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then m += Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then m -= Vector3.new(0,1,0) end
            rootPart.Velocity = m.Magnitude>0 and m.Unit*flySpeed or Vector3.new()
        end)
    else
        if humanoid then humanoid.PlatformStand = false end
        if connections.Fly then connections.Fly:Disconnect() end
    end
end, 6)
addSlider("✈️", "ความเร็วบิน", 1, 100, 30, function(v) flySpeed = v end, 7)
addSwitch("🧱", "ทะลุผนัง", function(on)
    connections.NoClip = RunService.Stepped:Connect(function()
        if not character then return end
        for _,p in ipairs(character:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = not on end end
    end)
    if not on and connections.NoClip then connections.NoClip:Disconnect() end
end, 8)
addSwitch("🌊", "เคลื่อนที่ลื่นไหล", function(on) if humanoid then humanoid.Friction = on and 0 or origFriction end end, 9)
addSwitch("🪂", "ตกลงช้า", function(on)
    connections.SlowFall = RunService.RenderStepped:Connect(function()
        if rootPart and on then rootPart.Velocity = Vector3.new(rootPart.Velocity.X, math.max(rootPart.Velocity.Y, -8), rootPart.Velocity.Z) end
    end)
    if not on and connections.SlowFall then connections.SlowFall:Disconnect() end
end, 10)

